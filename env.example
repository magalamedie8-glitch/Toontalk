# Copy this file to a new file named exactly:  .env   (same folder as server.js)
# Never share .env or commit it to GitHub.

# --- Luganda voices (Sunbird AI) ---
SUNBIRD_API_KEY=paste_your_sunbird_access_token_here

# --- English voices (optional, Azure) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- AI script helper (writes scripts from your idea). Get a key at console.anthropic.com ---
ANTHROPIC_API_KEY=
# Optional: which model writes the scripts (default is the fast, cheap one)
ANTHROPIC_MODEL=

# Optional: sunbird | azure | edge | none   (leave empty to choose automatically)
TTS_PROVIDER=
PORT=3000

# --- Voice languages ---
# While testing on your own computer, the Microsoft voices (hundreds, many languages) are listed together with Luganda.
# EDGE_VOICES=0 turns them off, EDGE_VOICES=1 keeps them on when the app is hosted (the free Edge list is unofficial; Azure above is the official way).
# VOICE_LANGS limits the languages, for example:  VOICE_LANGS=^(en-|sw-|fr-|ar-)
EDGE_VOICES=
VOICE_LANGS=
